:80 {
    # Serve static files from the /static directory
    root * /usr/share/caddy
    
    # Handle dashboard route
    handle /dashboard {
        rewrite * /dashboard.html
        file_server
    }
    
    # Handle impact circle route
    handle /impact-circle {
        rewrite * /impact-circle.html
        file_server
    }
    
    # Handle login route
    handle /login {
        rewrite * /login.html
        file_server
    }
    
    # Handle admin firmware route
    handle /admin/firmware {
        rewrite * /admin-firmware.html
        file_server
    }
    
    # Handle admin devices route
    handle /admin/devices {
        rewrite * /admin-devices.html
        file_server
    }
    
    # Handle admin users route
    handle /admin/users {
        rewrite * /admin-users.html
        file_server
    }
    
    # Handle admin tokens route
    handle /admin/tokens {
        rewrite * /admin-tokens.html
        file_server
    }
    
    # Enable file serving for all other routes
    file_server
    
    # Cache headers.
    #
    # Our own HTML, CSS and JS have no version in their filenames, so a
    # year-long max-age pinned returning visitors to whatever shipped last:
    # they would keep running the old settings-modal.js against freshly
    # deployed HTML. These files revalidate instead: file_server answers with
    # an ETag, so an unchanged file costs a 304 and no body.
    @app_assets {
        file
        path *.html *.css *.js
        not path /vendor/* /setup/vendor/*
    }
    header @app_assets Cache-Control "no-cache"

    # The extensionless page routes above are rewritten to .html inside their
    # handle blocks, which is too late for the matcher on @app_assets to see a
    # file, so they are named here and the pages people actually land on are not
    # heuristically cached either.
    # A directory request serves its index.html, but the request path carries no
    # extension, so it needs naming here too. "/" is the landing page.
    @page_routes path / /setup/ /dashboard /impact-circle /login /admin/*
    header @page_routes Cache-Control "no-cache"

    # Vendored libraries are pinned to a version and images never change under
    # the same name, so those keep the long cache.
    @immutable {
        file
        path /vendor/* /setup/vendor/* *.png *.jpg *.jpeg *.gif *.ico *.svg *.webp
    }
    header @immutable Cache-Control "public, max-age=31536000"
    
    # Security headers
    header {
        # Remove server header
        -Server
        
        # Security headers
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
    }
    
    # Logging
    log {
        output stdout
        format console
    }
}